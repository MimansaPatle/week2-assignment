# Copy this file to .env and adjust the values for your machine.
# Never commit the real .env file.

# Port the API listens on.
PORT=5000

# MongoDB connection string. The last part is the database name.
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/employee_management_mern
# MongoDB Atlas (replace the placeholders, keep the database name):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/employee_management_mern

# Address of the React app that is allowed to call this API from a browser.
# Separate several addresses with commas.
CLIENT_ORIGIN=http://localhost:5173
