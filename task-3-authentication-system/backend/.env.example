# Copy this file to .env (in this same backend folder) and fill in the values.
# Never commit the real .env file.

# Port the API listens on
PORT=5001

# MongoDB connection string. The last part is the database name.
MONGODB_URI=mongodb://127.0.0.1:27017/authentication_system_mern

# Secret used to sign login tokens. It must be at least 32 characters and
# the server refuses to start while this placeholder is still here.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret

# How long a login lasts (examples: 15m, 1h)
JWT_EXPIRES_IN=15m

# Address of the React app that is allowed to call this API from a browser.
# Separate several addresses with commas.
FRONTEND_URL=http://localhost:5173

NODE_ENV=development
